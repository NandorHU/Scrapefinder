<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="@color/bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="18dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Scrapefinder" android:textColor="@color/text" android:textSize="28sp" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Valós HardverApró + Facebook Marketplace figyelés" android:textColor="@color/muted" android:textSize="14sp" android:layout_marginTop="4dp" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@drawable/card_bg" android:layout_marginTop="18dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Marketplace API" android:textColor="@color/text" android:textStyle="bold" android:textSize="18sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="A Marketplace találatokhoz Apify API token kell. A token csak ezen a telefonon kerül mentésre."
                android:textColor="@color/muted" android:textSize="13sp" android:layout_marginTop="6dp" />
            <EditText android:id="@+id/apifyTokenInput" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="Apify API token" android:inputType="textPassword" android:textColor="@color/text" android:textColorHint="@color/muted" android:singleLine="true" />
            <EditText android:id="@+id/locationInput" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="Marketplace hely, pl. budapest" android:text="budapest" android:textColor="@color/text" android:textColorHint="@color/muted" android:singleLine="true" />
            <CheckBox android:id="@+id/autoScanCheck" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Automatikus figyelés 15 percenként" android:textColor="@color/text" android:checked="true" />
            <Button android:id="@+id/saveSettingsButton" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="API beállítások mentése" android:layout_marginTop="6dp" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@drawable/card_bg" android:layout_marginTop="14dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Új keresés" android:textColor="@color/text" android:textStyle="bold" android:textSize="18sp" />
            <EditText android:id="@+id/queryInput" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="pl. PS5 hibás" android:textColor="@color/text" android:textColorHint="@color/muted" android:singleLine="true" />
            <EditText android:id="@+id/maxPriceInput" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="Max ár, pl. 70000" android:inputType="number" android:textColor="@color/text" android:textColorHint="@color/muted" android:singleLine="true" />
            <Button android:id="@+id/addRuleButton" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Keresés hozzáadása" android:layout_marginTop="8dp" />
        </LinearLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Aktív keresések"
            android:textColor="@color/text" android:textStyle="bold" android:textSize="18sp" android:layout_marginTop="22dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Hosszan nyomva törölhető egy keresés."
            android:textColor="@color/muted" android:textSize="12sp" />
        <LinearLayout android:id="@+id/rulesContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />

        <Button android:id="@+id/scanButton" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Valós keresés most" android:layout_marginTop="20dp" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Legújabb találatok"
            android:textColor="@color/text" android:textStyle="bold" android:textSize="18sp" android:layout_marginTop="22dp" />
        <LinearLayout android:id="@+id/resultsContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />

        <Button android:id="@+id/updateButton" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Build / frissítések megnyitása" android:layout_marginTop="16dp" />
        <TextView android:id="@+id/statusText" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="v0.3 • Valós keresőmotor" android:textColor="@color/muted" android:gravity="center" android:layout_marginTop="18dp" android:layout_marginBottom="20dp" />
    </LinearLayout>
</ScrollView>
